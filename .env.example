# Database
DB_PASSWORD=postgres

# Admin Service
ADMIN_PASSWORD=admin123
SUBSCRIPTION_URL=http://localhost:8001

# Subscription Service
PROFILE_TITLE=VPN Service

# Feature: Device-Aware Fingerprint Randomization
# Randomly assigns TLS fingerprints (fp=) to each subscription fetch
# Creates traffic diversity to evade pattern detection
# Detects device type from User-Agent and assigns appropriate fingerprints:
#   - Desktop: chrome, firefox, edge, safari, random
#   - iPhone/iPad: ios, safari, chrome, random
#   - Android: android, chrome, firefox, random
# Set to "true" to enable, "false" to disable (default: false)
ENABLE_FP_RANDOMIZATION=false
