# Database
DB_PASSWORD=postgres

# Admin Service
ADMIN_PASSWORD=admin123
SUBSCRIPTION_URL=http://localhost:8001

# Subscription Service
PROFILE_TITLE=VPN Service
PROFILE_UPDATE_INTERVAL=3  # Hours between subscription updates (default: 3)

# Feature: Device-Aware Fingerprint Randomization
# Randomizes TLS fingerprints (fp=) based on device type:
#
# - Desktop: chrome, firefox, edge, safari, random (weighted)
# - iPhone/iPad: ios, safari, chrome, random (weighted)
# - Android: android, chrome, firefox, random (weighted)
#
# Creates traffic diversity to evade DPI pattern detection.
# Set to "true" to enable, "false" to disable (default: false)
#
# Note: ALPN addition temporarily disabled due to connection issues
ENABLE_FP_RANDOMIZATION=false
